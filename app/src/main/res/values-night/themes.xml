<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.OrbbecSdkExamples" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- 全局放大字体 -->
        <item name="android:textAppearance">@style/OBTextAppearance</item>
        <item name="android:textAppearanceLarge">@style/OBTextAppearance.Large</item>
        <item name="textAppearanceButton">@style/OBTextAppearance.Button</item>
        <item name="textAppearanceBody1">@style/OBTextAppearance</item>
        <item name="textAppearanceBody2">@style/OBTextAppearance</item>
        <item name="textAppearanceLargePopupMenu">@style/OBTextAppearance</item>
        <item name="textAppearanceSmallPopupMenu">@style/OBTextAppearance</item>
        <item name="android:textAppearanceLargePopupMenu">@style/OBTextAppearance</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/OBTextAppearance</item>
    </style>

    <!-- 正文默认 20sp -->
    <style name="OBTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- 大号文本 22sp -->
    <style name="OBTextAppearance.Large" parent="TextAppearance.AppCompat.Large">
        <item name="android:textSize">22sp</item>
    </style>

    <!-- 按钮文本 20sp -->
    <style name="OBTextAppearance.Button" parent="TextAppearance.AppCompat.Button">
        <item name="android:textSize">20sp</item>
    </style>
</resources>